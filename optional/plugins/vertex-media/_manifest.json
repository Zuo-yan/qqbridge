{
  "manifest_version": 2,
  "id": "local.vertex-media",
  "version": "0.5.1",
  "name": "Vertex 媒体",
  "description": "用户明确请求的图片生成、编辑和短语音；与统一TTS共用每天20条语音额度，视频未启用。",
  "author": {
    "name": "QQBridge local",
    "url": "http://localhost/qqbridge"
  },
  "urls": {
    "repository": "http://localhost/qqbridge/local-plugins/vertex-media"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "google-genai",
      "version_spec": ">=1.73.1,<3"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10,<13"
    }
  ],
  "plugin_type": "tool",
  "capabilities": [
    "send.image",
    "send.custom",
    "send.text",
    "send.hybrid",
    "message.get_by_id",
    "message.get_by_time_in_chat"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
