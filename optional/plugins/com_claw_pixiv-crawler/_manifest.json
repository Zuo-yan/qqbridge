{
  "manifest_version": 2,
  "id": "com.claw.pixiv-crawler",
  "version": "4.1.1",
  "name": "麦麦!来点二次元图片!",
  "description": "基于 cnmiw.com (MirlKoi API) 的随机二次元图片插件。支持色图/无色图随机发图、群聊私聊黑白名单、@触发、冷却防刷、近期去重。原图直发不压缩，无需 Pixiv 账号。",
  "author": {
    "name": "octmicy",
    "url": "https://github.com/octmicy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/octmicy/pixiv-crawler",
    "homepage": "https://github.com/octmicy/pixiv-crawler",
    "documentation": "https://github.com/octmicy/pixiv-crawler",
    "issues": "https://github.com/octmicy/pixiv-crawler/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    }
  ],
  "capabilities": [
    "send.image",
    "send.text",
    "message.get_by_time_in_chat"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
