{
  "manifest_version": 2,
  "id": "always-reply-private",
  "version": "2.5.2",
  "name": "私聊必回复",
  "description": "允许私聊情况下跳过时机模型，直接进行决策和回复，可设置白名单用户。",
  "author": {
    "name": "YanRuo630",
    "url": "https://github.com/YanRuo630"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/YanRuo630/always-reply-private",
    "homepage": "https://github.com/YanRuo630/always-reply-private",
    "documentation": "https://github.com/YanRuo630/always-reply-private/blob/main/README.md",
    "issues": "https://github.com/YanRuo630/always-reply-private/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "wrench"
    }
  },
  "capabilities": [
    "send_message"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
