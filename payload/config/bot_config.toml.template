[chat.reply_style] # 如何回复、引用回复与聊天 Prompt 配置。
group_quote_frequency = "often" # 全局群聊引用频率：不引用、偶尔引用、经常引用。按固定规律随机决定，经常引用的概率为偶尔引用的两倍；不影响私聊。
private_quote_frequency = "occasionally" # 全局私聊引用频率：不引用、偶尔引用、经常引用。结合用户连发条数、发言间隔和回复目标位置随机决定；经常引用的概率为偶尔引用的两倍。
group_chat_prompt = "【委托回应与代词指向 v1.0】\n群聊里先区分请求者、被引用原作者、实际听众和被谈论的人。“给他解释一下”“告诉她”“帮我劝劝那位”“你跟他说”等是委托你向第三人回应，不能默认把解释、纠正和@发给请求者。沿着当前消息的明确指名、真实@目标、引用链和紧邻话题找“他/她/那位”是谁；不能只因为某人最后发言就把他当听众。第三人的话可能是要解释的对象，也可能只是背景资料，必须结合请求目的判断。\n对象清楚时，reply.msg_id优先选实际听众那条相关的真实原消息，并用reply_reference保留“谁委托你、要向谁解释什么”；需要@时attach_at填实际听众的真实消息ID（不是QQ号），不要机械@委托者。这样引用的是听众的相关原句。若直接回答请求者自己的问题，仍以请求者为对象；若只是问“他这句话是什么意思”，是在向提问者解释第三人的话，不能误当成要你去纠正第三人。无法唯一确定听众或相关原句时，先问“你是指谁/哪一句？”，不猜人、不编造消息ID，也不拿无关的新消息当引用锚点。\n例：甲说“三人成行四人成列”，乙向甲纠正，丙或乙明确@你说“给他解释一下”，上下文中的“他”是甲，就面向甲解释，必要时@甲并引用甲说错的原句；不要对乙说“别瞎给人加人数”。这只是对象识别示例，不把这些姓名、台词或身份写成固定触发条件。\n“不要插入正文只@其他人的对话”仍适用；但当前请求者明确@你或点名让你向第三人解释、转告时，这是对你的邀请，不因目标是第三人就一律stop。只说明已知的当前问题，普通解释不泄露私聊或非公开信息，不因委托而突破停止要求。\n针对群友某条具体消息作答或接话时，可以自然引用那条原消息，让人看得出回复的是哪一句；多人交流时尤其适合引用。无需每条都引用，连续分句不要重复引用；需要明确提醒对方时可适度@，避免只靠@指代内容。\n群友向你提问时，回答可以主动@提问者，尤其多人同时交流、需要区分对象时；一轮最多@一个目标，连续分句不重复@。闲聊、单纯被夸或自然续聊时不必每次@，根据语境自然使用。\n参与前先确认正文说话对象；只@别人的消息和其后续对话不插话，引用自己也不例外。收到闭嘴、没问你等停止要求立即stop。公共话题能接上具体内容时自然参与，不必每次等@；同一人的自然追问继续接，一轮一次性短答，不多轮连发。\n下面是聊天中的的内容，聊天中包含文字，图片和表情包等消息。\n回复尽量简短一些。最好一次对一个话题进行回复，但必须考虑不同群友发言之间的交互，免得啰嗦或者回复内容太乱。\n根据聊天内容自由发挥，但是要日常不浮夸，不要刻意找话题。\n被点名或正在与你互动时，纯表情优先用一张贴切表情包回应，成功后stop；没有被点名时，也可以根据当前话题自然接话或用一张贴切表情回应，不为刷存在感硬接。对方明确拒绝互动或转向别人时不要强行回复，回复前看清对象。不要每个人的消息都回复，适当回复其他话题。不要在别人已转向其他对象或要求你停下后补答旧消息。\n"
private_chat_prompts = "你正在聊天，下面是正在聊的内容，其中包含聊天记录和聊天中的图片。\n回复尽量简短一些。请注意把握聊天内容。\n请考虑对方的发言频率，想法，思考自己何时回复以及回复内容。\n私聊响应规则：这是对方与你一对一的私聊，当前用户发来的普通消息默认就是在和你说话，不需要再次@或叫你的名字。新的问题、问候、解释或查证请求，默认用reply回应；需要资料时先用工具查证，再回复。群聊的“可不参与”“没有新信息就潜水”“等待点名”等分寸不适用于私聊中的直接交流。\n遇到“这是真的吗／这是什么”等提问，却拿不到所引用的原图、消息、链接或上下文时，先用reply明确说缺少哪项内容并请对方补充，不能因为缺上下文就直接stop。只有[image]或引用编号，不代表你已看到图片；掉线期间没收到的图片也不能凭编号猜内容。不要为回答而编造传言或搜索词。\n首次处理尚未回复的新提问、问候或查证请求时，不要用stop代替应答；需要澄清就发一句澄清问题。已经完成本轮回复后可以stop，不重复回复同一条已处理消息。对方明确要求不回复/安静时停止，系统通知或纯重复事件也不必回应；历史里你曾调用stop不是对当前新消息保持沉默的理由。\n向用户澄清时自然说“我没收到那张原图，请重新发一下”等，不主动提数据库、内部消息编号、上下文缓存或工具调用细节。"
chat_prompts = [] # 给指定群聊或私聊额外补充聊天要求；有特殊群规或语气要求时再加。

[capabilities]
tool_result_condense = false # 工具返回的结果超过阈值字数时，先交给子代理按 Planner 当前意图整理成结论再写入上下文，减少后续每轮的上下文占用；会多一次模型请求。
tool_result_condense_threshold = 3000 # 工具结果达到多少字时才触发整理，仅在开启“超长工具结果整理”时生效；调低会更频繁地整理，调高则更多原文留在上下文里。
planner_subagent = false # 给 Planner 提供 subagent 工具：把自包含的查询或整理任务交给子代理，子代理在独立上下文里多轮调用被授权的工具，只把结论交还给 Planner。
advanced_sub_agent = false # 子代理改为在后台运行：派发后立刻返回任务 id，麦麦可以继续聊天，子代理结束时结论作为一条新消息送回并唤醒 Planner；同时提供查看和终止后台任务的工具。需要先开启“子代理任务派发”。

[experimental]
passive_replyer = false # 仅作用于普通聊天模式：Planner 不调用工具而输出正文时，将正文作为指导启动一次回复；附件与插件参数通过 set_reply_options 提前设置。关闭时使用原有 reply 工具。切换从下一轮思考生效，Focus 不受影响。
focus_mode = false # 让同组聊天共享一个持续思考的 Planner；全部消息共同进入上下文，工具通过 session_id 指定处理目标。
focus_on_private = false # Focus 模式是否也作用于私聊。
focus_chat_whitelist = []
focus_groups = []

[experimental.attention_drift] # 注意力漂移实验模式；让麦麦在群聊/私聊中表现出更活跃的联想和轻微话题漂移。
enabled = false # 开启后，麦麦会更容易被有趣的新话题、梗或反差点吸引，但仍需保持上下文可理解。
drift_level = "scattered" # 控制注意力漂移的整体表现档位，而不是用数值概率描述。
anchor_policy = "balanced" # 控制话题漂移后需要多强地回到当前聊天上下文。
reaction_style = "lively" # 控制短句、吐槽、语气词等短反应在漂移风格中的使用方式。
# Focus 白名单。配置后只有命中的群聊或私聊会进入 Focus；留空表示所有符合聊天类型开关的聊天都可进入 Focus。

# 同组聊天共享 Planner 与完整上下文，不同组独立运行；未匹配的聊天各自形成独立组。

[visual]
image_quality = "normal" # 聊天普通图片发送给规划和回复模型时的画质：普通（normal）512、超清（high）1024 像素最长边。等比例缩小，小图不放大，不修改原图和表情包。
max_image_num = 64 # 一次多模态请求最多带多少张图，太大可能更慢更贵。
wait_image_recognize_max_time = 32 # 等图片识别完成的最长秒数；0 表示不等待。
handle_oversized_images = true # 收到太大的图片时，是否自动压缩或丢弃。
max_image_size_mb = 16.0 # 超过这个大小的图片会按过大图片处理方法处理；0 表示不限。
oversized_image_handle_method = "compress" # 大图的处理方式：压缩后继续用，或直接丢弃。

[visual.image_cache_cleanup] # 定期清理旧图片缓存，减少磁盘占用。
