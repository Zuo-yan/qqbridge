candidate_k = 80 # 段落候选数
relation_candidate_k = 60 # 关系候选数

[a_memorix.threshold] # 阈值过滤配置
min_threshold = 0.29 # 最小阈值
max_threshold = 0.95 # 最大阈值
percentile = 75 # 动态阈值百分位
min_results = 4 # 最小保留条数

[a_memorix.filter] # 聊天过滤配置
enabled = true # 是否启用聊天过滤
mode = "blacklist" # 过滤模式
chats = [] # 聊天流列表

[a_memorix.filter.retrieval.chat_stream] # 普通 paragraph/relation 命中的跨聊天流检索后置过滤
enabled = false # 是否启用当前检索结果类型的跨聊天流过滤
mode = "blacklist" # 过滤模式
chats = [] # 聊天流列表

[a_memorix.filter.retrieval.chat_summary] # 聊天总结命中的跨聊天流检索后置过滤
enabled = false # 是否启用当前检索结果类型的跨聊天流过滤
mode = "blacklist" # 过滤模式
chats = [] # 聊天流列表

[a_memorix.filter.retrieval.episode] # Episode 命中的跨聊天流检索后置过滤
enabled = false # 是否启用当前检索结果类型的跨聊天流过滤
mode = "blacklist" # 过滤模式
chats = [] # 聊天流列表

[a_memorix.episode] # Episode 配置
enabled = true # 是否启用 Episode
generation_enabled = true # 是否启用自动生成
source_poll_interval_seconds = 1 # 来源级 Episode 任务轮询间隔秒数
source_batch_size = 20 # 单轮领取的来源任务数
source_max_retry = 3 # 每个来源版本的最大尝试次数，包含首次尝试
source_lease_seconds = 1800 # 来源任务租约时长秒数
source_max_wait_seconds = 60 # 来源持续写入时允许的最大防抖等待秒数
max_paragraphs_per_call = 20 # 单次最大段落数
max_chars_per_call = 6000 # 单次最大字符数
source_time_window_hours = 24 # 时间窗口小时数
segmentation_model = "auto" # 分段模型选择
disabled_source_types = ["person_fact"] # 自动生成 Episode 时跳过的来源类型

[a_memorix.person_profile] # 人物画像配置
enabled = true # 是否启用画像
refresh_interval_minutes = 30 # 刷新间隔分钟数
active_window_hours = 72 # 活跃窗口小时数
max_refresh_per_cycle = 50 # 单轮最大刷新数
refresh_debounce_seconds = 120 # 写入触发画像刷新前等待的静默秒数
refresh_queue_interval_seconds = 60 # 画像刷新队列扫描间隔秒数
refresh_queue_batch_size = 10 # 画像刷新队列单轮处理人数
refresh_retry_backoff_seconds = 300 # 画像刷新失败后再次重试前等待的秒数
max_retry = 3 # 画像刷新队列最大重试次数
top_k_evidence = 12 # 证据条数
evidence_classification_max_tokens = 1200 # 人物画像证据分类最大输出 token 数

[a_memorix.memory] # 记忆演化配置
enabled = true # 是否启用记忆演化
half_life_hours = 24 # 半衰期小时数
prune_threshold = 0.1 # 裁剪阈值
freeze_duration_hours = 24 # 冻结时长小时数
revive_threshold = 0.15 # 冻结关系恢复为活跃状态的保留强度阈值
access_reinforcement_alpha = 0.05 # 记忆被最终采用时的饱和加强系数
access_reinforcement_cooldown_minutes = 60 # 同一关系两次访问加强之间的最短分钟数，0表示不限制
explicit_reinforcement_alpha = 0.5 # 用户显式加强或独立新证据的饱和加强系数
weaken_alpha = 0.5 # 显式弱化事件的比例系数
lifecycle_batch_size = 1000 # 单轮处理的到期关系数量

[a_memorix.advanced] # 高级运行时配置
enable_auto_save = true # 是否启用自动保存
auto_save_interval_minutes = 5 # 自动保存间隔
debug = false # 是否启用调试

[a_memorix.web.tuning] # 调优中心配置
enabled = true # 是否启用调优中心
max_queue_size = 8 # 最大队列长度
poll_interval_ms = 1200 # 轮询间隔毫秒数
default_intensity = "standard" # 默认调优强度
default_objective = "precision_priority" # 默认调优目标
default_top_k_eval = 20 # 默认评估 Top-K
default_sample_size = 24 # 默认样本数

[a_memorix.web.import] # 导入中心配置
enabled = true # 是否启用导入中心
max_queue_size = 20 # 最大队列长度
max_files_per_task = 200 # 单任务最大文件数
max_file_size_mb = 20 # 单文件大小上限 MB
max_paste_chars = 200000 # 粘贴字符数上限
default_file_concurrency = 2 # 默认文件并发
default_chunk_concurrency = 4 # 默认分块并发
default_narrative_window_size = 1600 # 默认叙事抽取窗口字符数
default_narrative_overlap = 400 # 默认叙事窗口重叠字符数
default_factual_target_size = 1200 # 默认事实分块目标字符数
max_chunk_chars = 3200 # 单个抽取分块的字符上限

[a_memorix.web.import.timeout] # 导入中心超时配置
llm_call_seconds = 240 # Web 导入中单次 LLM 抽取调用的超时时间，0 表示不额外限制
process_poll_seconds = 1 # 迁移或转换子进程状态轮询等待时间
process_terminate_seconds = 5 # 取消任务时等待子进程正常终止的时间
process_kill_seconds = 3 # 取消任务时强制结束子进程后的等待时间
convert_preflight_seconds = 20 # LPMM 转换依赖预检的超时时间

[message_receive]
image_parse_threshold = 5 # 单条消息图片数不超过这个值时才识图，避免图片太多拖慢处理。
ban_words = [] # 包含这些词的消息会被过滤，不进入麦麦处理。
ban_msgs_regex = [] # 用正则过滤消息；适合更复杂的过滤规则。

[voice]
enable_asr = false # 开启后麦麦可以把语音消息识别成文字再处理。

[emoji]
use_new_send_logic = false # 开启后由思考模型直接查看并挑选表情包，在文字回复后发送，需要思考模型支持视觉；关闭时沿用独立选择并发送表情包的旧方式。
emoji_send_num = 32 # 每次从多少个候选表情里挑一个发送；不是一次发送这么多。
max_reg_num = 128 # 最多保存多少个可用表情。
do_replace = true # 表情满了以后是否用新表情替换旧表情。
check_interval = 5 # 每隔多少分钟检查一次表情库状态。
steal_emoji = true # 是否从聊天中自动收集别人发的表情。
max_emoji_size_mb = 5.0 # 收集表情时允许的最大文件大小；0 表示不限。
content_filtration = false # 开启后只保存内容合适的表情。

[emoji.cache_cleanup] # 定期清理未注册表情包缓存，减少磁盘占用；已注册表情包不会被清理。
enabled = true # 开启后会自动删除长期未注册、未使用的表情包缓存。
check_interval_hours = 6.0 # 每隔多少小时检查一次旧表情包缓存。
emoji_file_retention_days = 30 # 未注册表情包文件多久没被使用后可以删除；已注册表情包永远不会由该任务删除。
no_file_record_retention_days = 30 # 未注册表情包文件删掉后，描述缓存记录还能保留多久。

[keyword_reaction]
keyword_rules = [] # 命中关键词后，给麦麦追加一段固定反应提示。
regex_rules = [] # 命中正则规则后，给麦麦追加一段固定反应提示。

[response_post_process]
enable_response_post_process = true # 开启后会对回复做错别字、分段等后处理。
typing_speed = 1.0 # 模拟打字等待时间；0 最快，1 默认，2 更慢。

[chinese_typo]
enable = true # 让麦麦偶尔打错字，更像真人聊天。
enable_correction_quote = true # 纠正错别字时，是否引用上一条包含错别字的消息。
correction_quote_probability = 1.0 # 生成纠正消息时，引用上一条错别字消息的概率。
error_rate = 0.01 # 单个字被替换成错字的概率。
min_freq = 9 # 只对常见程度达到该值的字尝试制造错字。
tone_error_rate = 0.1 # 按相近声调制造错字的概率。
word_replace_rate = 0.006 # 整词被替换成错词的概率。

[response_splitter]
mode = "rule" # 规则断句或使用 LLM 按语义断句。
enable = true # 把过长回复拆成多条发送。
max_length = 512 # 单条回复允许的最大长度。
max_sentence_num = 8 # 单条回复最多包含多少个句子。
max_split_num = 3 # 一次回复最多拆成几条消息。
enable_kaomoji_protection = false # 尽量避免把颜文字从中间拆开。
enable_overflow_return_all = true # 句子太多时是否直接保留完整回复，不再强行截断。

[telemetry]
enable = true # 是否发送匿名运行统计；关闭不影响正常使用。

[log]
date_style = "m-d H:i:s" # 日志时间的显示格式。
log_level_style = "lite" # 日志等级的显示样式，只影响日志外观。
color_text = "full" # 控制台日志颜色范围。
log_level = "INFO" # 全局最低日志等级；DEBUG 最详细，ERROR 最安静。
console_log_level = "INFO" # 控制台输出的最低日志等级。
file_log_level = "DEBUG" # 写入日志文件的最低日志等级。
log_file_max_bytes = 5242880 # 单个日志文件超过这个大小后会轮转。
max_log_files = 30 # 最多保留多少个主日志文件。
log_cleanup_days = 30 # 主日志文件超过多少天后清理。
llm_request_snapshot_limit = 128 # 失败模型请求快照最多保留多少份。
maisaka_prompt_preview_limit = 256 # 每个聊天最多保留多少组 Prompt 预览。
memory_diagnostics_enabled = true # 启用独立内存诊断日志；最多四个 5 MiB 文件，修改后重启生效。
memory_diagnostics_deep_enabled = false # 启用 tracemalloc 分配位置对比（每十分钟）；有额外内存和 CPU 开销，排查时开启，重启生效。
memory_diagnostics_interval_seconds = 60.0 # 轻量内存诊断采集间隔（秒，至少 10 秒），修改后重启生效。
event_loop_watchdog_enabled = false # 是否记录事件循环卡顿；主循环与 WebUI 循环各有一份，用于排查界面卡顿。
event_loop_watchdog_warn_seconds = 0.5 # 事件循环唤醒延迟超过该秒数时记录一条警告日志。
suppress_libraries = [
    "faiss",
    "httpx",
    "urllib3",
    "asyncio",
    "websockets",
    "httpcore",
    "requests",
    "sqlalchemy",
    "openai",
    "uvicorn",
    "jieba",
] # 完全不显示日志的第三方库名称列表。
library_log_levels = {aiohttp = "WARNING", PIL = "WARNING"} # 单独设置某些第三方库的日志等级。

[debug]
replyer_retro_prompt = false # 按旧版（0.12.x）的方式组织 replyer 提示词：全部回复指令集中在一份完整模板里，用块占位符填充，群聊/私聊/简短回复各用一套模板，并整段作为一条 user 消息发送。仅检查实际分配给 replyer 的模型：名称或标识包含 mai_replier（兼容 mai-replier），或为 v2p1-contract、v2p1-raw 时自动开启且不可关闭；解除这些模型的 replyer 分配后清除自动开关，未分配的模型不影响此设置。其他模型可手动开启。
enable_console_input = true # 在交互式终端中启用本地消息和指令输入。
show_maisaka_thinking = false # 在终端显示思考过程大框，不影响推理记录保存和 WebUI 查看。
save_maisaka_reasoning = true # 保存 Planner、工具调用及聊天回想的完整推理记录，供 WebUI 查看，与终端显示独立。
keep_prompt_preview_json_base64 = false # Prompt 预览里保留图片 base64，便于复现但会占空间。
record_tool_structured_content = false # 保存工具返回的结构化内容，便于调试但会增加数据库体积。
enable_llm_cache_stats = false # 记录模型 prompt cache 统计，用于性能调试。
force_plugin_compatibility = false # 跳过插件声明的 Host 和 SDK 版本范围校验，直接加载插件；开启后需重启生效。

[maim_message]
enabled = true # 消息服务总开关；关闭后不启动旧版 WS 和新版 API 服务，重启生效，不影响插件式适配器。
ws_server_host = "127.0.0.1" # 旧版 WebSocket 服务监听地址；不清楚就保持默认。
ws_server_port = 8000 # 旧版 WebSocket 服务端口。
auth_token = [] # 旧版 API 的认证令牌；为空表示不验证。
enable_api_server = false # 是否开启新版 API Server，供外部程序调用麦麦。
api_server_host = "0.0.0.0" # 新版 API Server 监听地址；0.0.0.0 表示允许外部访问。
api_server_port = 8090 # 新版 API Server 监听端口。
api_server_use_wss = false # 新版 API Server 是否使用加密 WebSocket。
api_server_cert_file = "" # WSS 使用的证书文件路径。
api_server_key_file = "" # WSS 使用的私钥文件路径。
api_server_allowed_api_keys = [] # 允许访问新版 API 的 Key 列表；为空表示不限制。

[webui]
enabled = true # 是否启动 WebUI 管理界面。
host = [
    "127.0.0.1",
    "::1",
] # WebUI 监听地址列表；可同时绑定 IPv4 和 IPv6，例如 ["0.0.0.0", "::"]。
port = 8001 # WebUI 访问端口。
mode = "production" # WebUI 运行模式；普通使用保持 production。
webui_style = 2 # 界面风格编号；0 为旧风格，1 为未来复古风格，2 为千禧风格。
anti_crawler_mode = "basic" # 防爬虫策略；basic 只记录，strict/loose 会拦截更多请求。
allowed_ips = "127.0.0.1" # 允许访问 WebUI 的 IP，多个用逗号分隔。
trusted_proxies = "" # 可信反向代理 IP；只有这些代理传来的真实 IP 会被信任。
trust_xff = false # 是否信任 X-Forwarded-For 里的真实访客 IP。
secure_cookie = false # 只在 HTTPS 下发送登录 Cookie；没有 HTTPS 时不要开启。
enforce_public_outbound_url = true # 限制 WebUI 访问外部 URL，降低访问内网地址的风险。
enable_paragraph_content = false # 知识图谱里是否加载段落全文；更完整但更占内存。

[database]
save_binary_data = false # 是否保存语音等二进制原文件；更占空间，但方便以后重新识别。

[mcp]
enable = true # 是否启用 MCP 工具接入能力。
servers = []

[mcp.client] # 麦麦作为 MCP 客户端时声明的能力。
client_name = "MaiBot" # 对 MCP 服务器展示的客户端名称。
client_version = "1.0.0" # 对 MCP 服务器展示的客户端版本。

[mcp.client.roots] # 是否向 MCP 服务器提供可访问的文件根目录。
enable = false # 是否向 MCP 服务器暴露 Roots 能力。
items = [] # 允许 MCP 服务器看到的目录或资源列表。

[mcp.client.sampling] # 是否允许 MCP 服务器请求麦麦调用模型。
enable = false # 是否声明支持 MCP Sampling。
task_name = "planner" # MCP Sampling 调用模型时使用的任务名。
include_context_support = false # 是否允许 Sampling 请求带上下文。
tool_support = false # Sampling 过程中是否允许继续使用工具。

[mcp.client.elicitation] # 是否允许 MCP 服务器向麦麦请求补充信息。
enable = false # 是否声明支持 MCP Elicitation。
allow_form = true # 是否允许 MCP 服务器请求填写表单。
allow_url = false # 是否允许 MCP 服务器请求打开 URL。
# 要连接的 MCP 服务器列表。

[plugin]
permission = [] # 允许用聊天命令管理插件的用户，格式如 qq:123456789。
silent_permission_denied = false # 开启后，用户执行无权限命令时不再发送提示消息，仅静默拦截并记录日志。
command_permissions = {} # 受保护命令按用户和真实聊天流配置的额外放行规则。
disabled_commands = [] # 在命令管理中停用的命令 ID 列表（格式为 plugin_id.command_name，内置命令为 core.clear）。

[plugin_runtime]
enabled = true # 是否启用新版插件运行时。
health_check_interval_sec = 30.0 # 每隔多少秒检查一次插件运行状态。
max_restart_attempts = 3 # 插件 Runner 崩溃后最多自动重启几次。
runner_spawn_timeout_sec = 30.0 # 等待插件 Runner 启动完成的最长时间。
hook_blocking_timeout_sec = 60 # 单个阻塞 Hook 最多允许运行多久。
ipc_socket_path = "" # 自定义插件通信 Socket 路径；留空自动生成。

[plugin_runtime.render] # 插件需要网页截图或渲染时使用的浏览器配置。
enabled = true # 是否允许插件使用浏览器渲染能力。
browser_ws_endpoint = "" # 已有 Chrome/Chromium 的调试地址；留空则自动启动。
executable_path = "" # 浏览器程序路径；留空自动查找。
browser_install_root = "data/playwright-browsers" # 自动下载浏览器时保存的位置。
headless = true # 是否隐藏浏览器窗口运行。
launch_args = [
    "--disable-gpu",
    "--disable-dev-shm-usage",
    "--disable-setuid-sandbox",
    "--no-sandbox",
    "--no-zygote",
] # 启动浏览器时附加的命令参数。
concurrency_limit = 1 # 同时最多运行多少个渲染任务。
startup_timeout_sec = 20.0 # 浏览器启动或连接的最长等待时间。
render_timeout_sec = 15.0 # 单次渲染任务的最长等待时间。
auto_download_chromium = true # 找不到浏览器时是否自动下载 Chromium。
download_connection_timeout_sec = 120.0 # 下载 Chromium 时的连接超时时间。
restart_after_render_count = 200 # 渲染多少次后重启浏览器；0 表示不自动重启。
