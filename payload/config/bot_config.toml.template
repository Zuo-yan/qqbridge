check_interval_hours = 6.0 # 每隔多少小时检查一次旧图片。
image_file_retention_days = 14 # 图片文件多久没被使用后可以删除。
no_file_result_retention_days = 30 # 图片文件删掉后，识别文字还能保留多久。

[expression]
expression_checked_only = false # 仅使用人工精选的表达。
expression_self_reflect = true # 写入表达方式前先让 AI 检查，减少学到奇怪内容。
use_vector_expression = false # 表达选择档位：false 为快速，加权随机抽样后直接注入，不额外调用选择 LLM；true 为精细，使用表达意图与嵌入召回，再由 LLM 筛选，需要配置嵌入模型。复古回复不使用表达选择。
