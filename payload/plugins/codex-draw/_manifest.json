{
  "manifest_version": 2,
  "id": "codex-draw",
  "version": "0.1.3",
  "name": "Codex 绘图",
  "description": "Codex绘图与原图编辑；自然语言gpt_draw支持按当前聊天消息ID和图片序号传入原图。",
  "author": {
    "name": "SawataLi",
    "url": "https://github.com/SawataLi"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/SawataLi/codex-draw",
    "homepage": "https://github.com/SawataLi/codex-draw",
    "documentation": "https://github.com/SawataLi/codex-draw/blob/main/README.md",
    "issues": "https://github.com/SawataLi/codex-draw/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}